let currentQuestion = 0;
let score = 0;
let selectedAnswer = null;


const questionCounter =
    document.getElementById("questionCounter");

const quizPoints =
    document.getElementById("quizPoints");

const quizProgress =
    document.getElementById("quizProgress");

const quizCategory =
    document.getElementById("quizCategory");

const quizQuestion =
    document.getElementById("quizQuestion");

const quizOptions =
    document.getElementById("quizOptions");

const quizFeedback =
    document.getElementById("quizFeedback");

const quizNext =
    document.getElementById("quizNext");

const quizGame =
    document.getElementById("quizGame");

const quizResult =
    document.getElementById("quizResult");


function loadQuestion() {

    const question = questions[currentQuestion];

    selectedAnswer = null;

    questionCounter.textContent =
        `${String(currentQuestion + 1).padStart(2, "0")} / 05`;

    quizPoints.textContent =
        `${score} ${score === 1 ? "ponto" : "pontos"}`;

    quizProgress.style.width =
        `${((currentQuestion + 1) / questions.length) * 100}%`;

    quizCategory.textContent =
        question.category;

    quizQuestion.textContent =
        question.question;

    quizFeedback.textContent = "";

    quizNext.disabled = true;

    quizNext.innerHTML =
        `Continuar <i class="fa-solid fa-arrow-right"></i>`;

    quizOptions.innerHTML = "";


    question.options.forEach((option, index) => {

        const button =
            document.createElement("button");

        button.className = "quiz-option";

        button.textContent = option;

        button.addEventListener("click", () => {

            selectAnswer(index);

        });

        quizOptions.appendChild(button);

    });

}


function selectAnswer(index) {

    if (selectedAnswer !== null) {
        return;
    }

    selectedAnswer = index;

    const question = questions[currentQuestion];

    const buttons =
        document.querySelectorAll(".quiz-option");

    buttons.forEach(button => {
        button.disabled = true;
    });


    buttons[index].classList.add("selected");


    if (index === question.correct) {

        score++;

        buttons[index].classList.add("correct");

        quizFeedback.innerHTML =
            `<strong style="color:#239b55">
                ✓ Correto!
            </strong>
            ${question.explanation}`;

    } else {

        buttons[index].classList.add("wrong");

        buttons[question.correct]
            .classList.add("correct");

        quizFeedback.innerHTML =
            `<strong style="color:#ff3b30">
                ✕ Não exatamente.
            </strong>
            ${question.explanation}`;

    }


    quizPoints.textContent =
        `${score} ${score === 1 ? "ponto" : "pontos"}`;

    quizNext.disabled = false;

}


quizNext.addEventListener("click", () => {

    currentQuestion++;

    if (currentQuestion < questions.length) {

        loadQuestion();

    } else {

        showResult();

    }

});


function showResult() {

    quizGame.classList.add("hidden-game");

    quizResult.classList.add("active");

    document.getElementById("resultScore")
        .textContent =
        `${score}/5`;


    const title =
        document.getElementById("resultTitle");

    const description =
        document.getElementById("resultDescription");


    if (score === 5) {

        title.textContent =
            "Você está atento aos sinais.";

        description.textContent =
            "Excelente! Você conseguiu reconhecer situações importantes e demonstrou conhecimento sobre formas de violência e caminhos de apoio.";

    } else if (score >= 3) {

        title.textContent =
            "Você já reconhece muita coisa.";

        description.textContent =
            "Muito bem. Algumas situações podem parecer difíceis de identificar, por isso continuar aprendendo é importante.";

    } else {

        title.textContent =
            "Conhecimento também se aprende.";

        description.textContent =
            "Não tem problema. O objetivo deste teste é justamente ajudar você a reconhecer sinais e entender quando procurar apoio.";

    }

}


